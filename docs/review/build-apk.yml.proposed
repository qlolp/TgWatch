name: Build APK
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
  workflow_dispatch:
    inputs:
      publish:
        description: Publish signed release (requires signing secrets)
        type: boolean
        default: false
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    concurrency:
      # A push may cancel older push checks, never a manual publication's checks.
      group: tgwatch-check-build-${{ github.event_name }}-${{ github.ref }}-${{ github.event_name == 'workflow_dispatch' && github.run_id || 'automatic' }}
      cancel-in-progress: true
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Validate Gradle wrapper
        uses: gradle/actions/wrapper-validation@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Release policy regression tests
        run: |
          python3 -m pip install --require-hashes -r scripts/requirements-release.lock
          python3 -m unittest discover -s scripts/tests -v
          python3 scripts/test_dependency_audit.py
          python3 scripts/test_signing_keychain.py
      - name: Unit tests, Android lint and APKs
        run: bash ./gradlew detekt testDebugUnitTest lintDebug assembleDebug assembleRelease dependencyInventory generateReleaseSbom --no-daemon --stacktrace
      - name: Audit all exact resolved runtime and test dependencies against OSV
        run: python3 scripts/dependency-audit.py app/build/reports/dependencies/resolved.json app/build/reports/dependencies/osv-report.json
      - name: Install pinned Trivy scanner
        uses: aquasecurity/setup-trivy@e07451d2e059ed86c2870430ea286b3a9e0bf241
        with:
          version: v0.75.0
      - name: Gate release runtime SBOM on HIGH and CRITICAL vulnerabilities
        run: bash scripts/scan-sbom.sh app/build/reports/sbom/TgWatch.sbom.cdx.json app/build/reports/sbom/TgWatch.trivy.json
      - name: SBOM and vulnerability scan reports
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: sbom-reports
          path: |
            app/build/reports/sbom/TgWatch.sbom.cdx.json
            app/build/reports/sbom/TgWatch.trivy.json
            app/build/reports/sbom/TgWatch.trivy.status.json
            app/build/reports/sbom/TgWatch.trivy.log
      - name: Resolved dependency graphs and OSV audit report
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: dependency-reports
          path: |
            app/build/reports/dependencies/resolved.json
            app/build/reports/dependencies/osv-report.json
      - name: Upload test and lint reports
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: quality-reports
          path: app/build/reports/
      - name: Print lint diagnostics
        if: always()
        run: cat app/build/intermediates/lint_intermediate_text_report/debug/lintReportDebug/lint-results-debug.txt 2>/dev/null || true
      - name: Unit test summary
        if: always()
        run: |
          python3 - <<'PY'
          import pathlib, xml.etree.ElementTree as ET
          suites = [ET.parse(p).getroot() for p in pathlib.Path('app/build/test-results/testDebugUnitTest').glob('TEST-*.xml')]
          for key in ('tests', 'failures', 'errors', 'skipped'):
              print(f'{key}: {sum(int(s.get(key, 0)) for s in suites)}')
          PY
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: TgWatch-debug-test-only
          path: app/build/outputs/apk/debug/*.apk
      - name: Signing readiness
        env:
          SIGNING_READY: ${{ secrets.TGWATCH_KEYSTORE_BASE64 != '' && secrets.TGWATCH_KEYSTORE_PASSWORD != '' && secrets.TGWATCH_KEY_ALIAS != '' && secrets.TGWATCH_KEY_PASSWORD != '' }}
        run: |
          if [ "$SIGNING_READY" = true ]; then
            echo 'Production signing key configured.' >> "$GITHUB_STEP_SUMMARY"
          else
            echo 'Production signing is not configured. Use scripts/configure-signing.sh with the existing production backup on a trusted Mac. It never creates a replacement key; debug APKs are test-only.' >> "$GITHUB_STEP_SUMMARY"
          fi
  release:
    needs: [build, android]
    if: (github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')) || (github.event_name == 'workflow_dispatch' && inputs.publish && github.ref == 'refs/heads/main')
    runs-on: ubuntu-latest
    timeout-minutes: 90
    concurrency:
      # Serial across version tags and manual publications; checks have separate groups.
      group: tgwatch-publication-${{ github.repository }}
      cancel-in-progress: false
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - name: Validate source tag, main ancestry and monotonic publication before signing
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 -m pip install --require-hashes -r scripts/requirements-release.lock
          python3 scripts/release-policy.py --repo "$GITHUB_REPOSITORY" \
            --sha "$(git rev-parse HEAD)" --ref "$GITHUB_REF" --preflight
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Download this run's successful SBOM scan
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: sbom-reports
          path: release-evidence
      - name: Download this run's full dependency audit
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: dependency-reports
          path: release-dependencies
      - name: Validate scan evidence
        run: |
          python3 -m pip install --require-hashes -r scripts/requirements-release.lock
          python3 scripts/verify-audit-evidence.py \
            --sbom release-evidence/TgWatch.sbom.cdx.json --trivy release-evidence/TgWatch.trivy.json \
            --status release-evidence/TgWatch.trivy.status.json \
            --inventory release-dependencies/resolved.json --osv release-dependencies/osv-report.json
      - name: Build with persistent signing key
        env:
          TGWATCH_KEYSTORE_BASE64: ${{ secrets.TGWATCH_KEYSTORE_BASE64 }}
          TGWATCH_KEYSTORE_PASSWORD: ${{ secrets.TGWATCH_KEYSTORE_PASSWORD }}
          TGWATCH_KEY_ALIAS: ${{ secrets.TGWATCH_KEY_ALIAS }}
          TGWATCH_KEY_PASSWORD: ${{ secrets.TGWATCH_KEY_PASSWORD }}
          TGWATCH_KEYSTORE_PATH: ${{ runner.temp }}/tgwatch-release.p12
        run: |
          set -euo pipefail
          : "${TGWATCH_KEYSTORE_BASE64:?Missing signing key}"
          : "${TGWATCH_KEYSTORE_PASSWORD:?Missing store password}"
          : "${TGWATCH_KEY_ALIAS:?Missing alias}"
          : "${TGWATCH_KEY_PASSWORD:?Missing key password}"
          trap 'rm -f "$TGWATCH_KEYSTORE_PATH"' EXIT
          umask 077
          printf '%s' "$TGWATCH_KEYSTORE_BASE64" | base64 --decode > "$TGWATCH_KEYSTORE_PATH"
          bash ./gradlew assembleRelease generateReleaseSbom --no-daemon
          "$ANDROID_HOME/build-tools/35.0.0/apksigner" verify --verbose --print-certs app/build/outputs/apk/release/app-release.apk
          cp app/build/outputs/apk/release/app-release.apk TgWatch.apk
          sha256sum TgWatch.apk > TgWatch.apk.sha256
          cmp app/build/reports/sbom/TgWatch.sbom.cdx.json release-evidence/TgWatch.sbom.cdx.json
          cmp app/build/reports/dependencies/resolved.json release-dependencies/resolved.json
          cp release-evidence/TgWatch.sbom.cdx.json TgWatch.sbom.cdx.json
          cp release-evidence/TgWatch.trivy.json TgWatch.trivy.json
          cp release-dependencies/resolved.json TgWatch.dependencies.json
          cp release-dependencies/osv-report.json TgWatch.osv.json
      - name: Select and verify the previous published release for the upgrade check
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          python3 scripts/upgrade-baseline.py --repo "$GITHUB_REPOSITORY"
          if [ -f previous/TgWatch.apk ]; then
            echo "upgrade_check=true" >> "$GITHUB_ENV"
          else
            echo "upgrade_check=false" >> "$GITHUB_ENV"
          fi
      - name: Verify signing continuity with the previous published release
        if: env.upgrade_check == 'true'
        run: |
          set -euo pipefail
          signer="$ANDROID_HOME/build-tools/35.0.0/apksigner"
          "$signer" verify --print-certs previous/TgWatch.apk > previous-signature.txt
          "$signer" verify --print-certs TgWatch.apk > release-signature.txt
          diff <(grep 'Signer #1 certificate SHA-256 digest:' previous-signature.txt) <(grep 'Signer #1 certificate SHA-256 digest:' release-signature.txt)
          python3 - <<'PY'
          import pathlib, re
          expected = 'ab74727a44f59684045e7db4c820be309f886433a18a3c06f3439417f3acbef1'
          for name in ('previous-signature.txt', 'release-signature.txt'):
              digests = re.findall(r'^Signer #1 certificate SHA-256 digest: ([0-9a-fA-F]{64})$', pathlib.Path(name).read_text(), re.M)
              assert [digest.lower() for digest in digests] == [expected], 'Production signing identity mismatch'
          PY
      - name: Enable KVM for signed upgrade
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - name: Upgrade the real signed release without clearing data
        if: env.upgrade_check == 'true'
        uses: reactivecircus/android-emulator-runner@a421e43855164a8197daf9d8d40fe71c6996bb0d # v2
        with:
          api-level: 35
          arch: x86_64
          disable-animations: true
          script: bash scripts/signed-upgrade-smoke.sh previous/TgWatch.apk TgWatch.apk
      - name: Signed upgrade reports
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: signed-upgrade-reports
          path: |
            signed-upgrade-logcat.txt
            upgrade-*.xml
            upgrade-*.csv
            release-screen.png
      - name: Publish versioned release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          version=$(sed -n 's/^version=//p' version.properties)
          sha256sum -c TgWatch.apk.sha256
          signer="$ANDROID_HOME/build-tools/35.0.0/apksigner"
          "$signer" verify --print-certs TgWatch.apk > /dev/null
          "$ANDROID_HOME/build-tools/35.0.0/aapt2" dump badging TgWatch.apk > badging.txt
          python3 - <<'PY'
          import pathlib
          version = pathlib.Path('version.properties').read_text().strip().split('=', 1)[1]
          major, minor, patch = map(int, version.split('.'))
          badging = pathlib.Path('badging.txt').read_text()
          assert f"versionCode='{major * 1000000 + minor * 1000 + patch}'" in badging, 'APK versionCode mismatch'
          assert f"versionName='{version}'" in badging, 'APK versionName mismatch'
          PY
          python3 scripts/release-policy.py --repo "$GITHUB_REPOSITORY" \
            --sha "$(git rev-parse HEAD)" --ref "$GITHUB_REF" \
            --notes "docs/releases/${version}.md" \
            --assets TgWatch.apk TgWatch.apk.sha256 TgWatch.sbom.cdx.json TgWatch.trivy.json TgWatch.dependencies.json TgWatch.osv.json
  android:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    concurrency:
      group: tgwatch-check-android-${{ matrix.api }}-${{ github.event_name }}-${{ github.ref }}-${{ github.event_name == 'workflow_dispatch' && github.run_id || 'automatic' }}
      cancel-in-progress: true
    strategy:
      fail-fast: false
      matrix:
        api: [29, 35]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - uses: reactivecircus/android-emulator-runner@a421e43855164a8197daf9d8d40fe71c6996bb0d # v2
        with:
          api-level: ${{ matrix.api }}
          arch: x86_64
          disable-animations: true
          script: bash scripts/android-smoke.sh
      - name: Connected Android test summary and bounded failure annotations
        if: always()
        run: python3 scripts/report-android-tests.py app/build/outputs/androidTest-results/connected
      - name: Android reports
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: android-reports-${{ matrix.api }}
          path: |
            app/build/reports/androidTests/
            app/build/outputs/androidTest-results/connected/
            smoke-logcat.txt
