<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть: сама проверка и определение, есть ли вообще интернет -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Вибрация при потере связи -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Постоянная работа в фоне со значком в строке состояния -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Точный будильник: будит телефон к следующей проверке при выключенном экране -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Автозапуск после перезагрузки телефона -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TgWatchApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/automation_backup_rules"
        android:dataExtractionRules="@xml/automation_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only this app can open credential management. The bearer-token API
             is explicitly addressed by clients; it has no discovery filter. -->
        <activity
            android:name=".AutomationSettingsActivity"
            android:exported="false" />
        <receiver
            android:name=".AutomationReceiver"
            android:directBootAware="false"
            android:exported="true" />

        <service
            android:name=".MonitorService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous monitoring of Telegram API reachability for the user" />
        </service>

        <!-- Плитка «Telegram» в быстрых настройках шторки -->
        <service
            android:name=".StatusTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_ok"
            android:label="@string/telegram"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Виджет со статусом на рабочем столе -->
        <receiver
            android:name=".WatchdogReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".DailySummaryReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".StatusWidget"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status_info" />
        </receiver>

        <!-- Нажатие на виджет: только собственный PendingIntent, не другие приложения -->
        <receiver
            android:name=".WidgetClickReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Системные broadcast доставляются и неэкспортированному получателю -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Xiaomi / некоторые OEM будят иначе, чем обычный BOOT_COMPLETED -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- Сводка за день привязана к местному времени -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
