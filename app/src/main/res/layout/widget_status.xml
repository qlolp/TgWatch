<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет на рабочем столе: цветная плашка со статусом Telegram -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_idle"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/widgetIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/status_icon"
        android:src="@drawable/ic_stat_wait" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Telegram"
            android:textColor="@color/on_status"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widgetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.9"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_status"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
