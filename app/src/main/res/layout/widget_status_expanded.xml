<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_widget_idle">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView android:id="@+id/widgetIcon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_stat_wait" android:contentDescription="@string/status_icon" />
        <TextView android:id="@+id/widgetTitle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="14sp" android:paddingStart="8dp"
            android:paddingEnd="0dp" android:maxLines="2" android:textColor="@color/on_status" />
    </LinearLayout>
    <TextView android:id="@+id/widgetSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/on_status" />
    <TextView android:id="@+id/widgetLastSuccess" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/on_status" />
    <TextView android:id="@+id/widgetCoverage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/on_status" />
    <ImageView android:id="@+id/widgetGraph" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="12dp" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/widgetCheck" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/check_now"
            android:textSize="12sp" />
        <Button android:id="@+id/widgetMute" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/widget_mute_hour"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
