<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/targetSelector"
            android:text="@string/target_select" />

        <Spinner
            android:id="@id/targetSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnTargetSettings"
            style="@style/ButtonOutlined"
            android:layout_width="match_parent"
            android:text="@string/target_settings" />

        <!-- Чеклист первого запуска: без этого значок врёт -->
        <LinearLayout
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/setup_title" />

            <TextView
                android:id="@+id/tvSetup"
                style="@style/Body"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnSetupNotif"
                style="@style/ButtonFilled"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/enable_notifications" />

            <Button
                android:id="@+id/btnSetupBattery"
                style="@style/ButtonFilled"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/allow_unrestricted" />

            <Button
                android:id="@+id/btnSetupAlarm"
                style="@style/ButtonFilled"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/allow_exact_alarms" />

            <Button
                android:id="@+id/btnSetupApp"
                style="@style/ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/open_app_settings" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStatus"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_status_icon"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_stat_wait" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/on_status"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvSince"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_status"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvEgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_status"
                        android:textSize="14sp"
                        android:visibility="gone" />
                    <Button android:id="@+id/btnRegionalServices" style="@style/ButtonText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/regional_title" />
                    <Button android:id="@+id/btnRefreshCountry" style="@style/ButtonText"
                        android:layout_width="match_parent" android:text="@string/country_refresh" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/on_status"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnResumeAlerts"
                style="@style/ButtonText"
                android:layout_marginTop="4dp"
                android:text="@string/alerts_resume"
                android:textColor="@color/on_status"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatBox">

                <TextView
                    android:id="@+id/tvLatency"
                    style="@style/StatValue" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_latency" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatBox"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvUptime"
                    style="@style/StatValue" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_uptime" />
            </LinearLayout>

            <LinearLayout style="@style/StatBox">

                <TextView
                    android:id="@+id/tvChecked"
                    style="@style/StatValue" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_checked" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCheck"
                style="@style/ButtonFilled"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/check_now" />

            <Button
                android:id="@+id/btnToggle"
                style="@style/ButtonOutlined"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/monitor_health_title" />
            <TextView android:id="@+id/tvMonitorHealth" style="@style/Body" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/history_title" />

            <Button android:id="@+id/btnPeriod" style="@style/ButtonText" android:text="@string/period_day" />
            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="8dp"
                android:text="@string/history_retention_label" />
            <RadioGroup
                android:id="@+id/rgRetention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rbRetentionWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="@string/history_retention_week" />
                <RadioButton
                    android:id="@+id/rbRetentionMonth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="@string/history_retention_month" />
                <RadioButton
                    android:id="@+id/rbRetentionQuarter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="@string/history_retention_quarter" />
            </RadioGroup>
            <Button android:id="@+id/btnLatency" style="@style/ButtonText" android:text="@string/latency_title" />
            <Button android:id="@+id/btnShareStatus" style="@style/ButtonText" android:text="@string/share_status_title" />
            <Button android:id="@+id/btnIncidents" style="@style/ButtonText" android:text="@string/incidents_title" />
            <TextView
                android:id="@+id/tvDayStats"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/history_empty" />

            <TextView android:id="@+id/tvCoverage" style="@style/Body" android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnShareStats"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="4dp"
                android:text="@string/share_summary" />
            <Button android:id="@+id/btnExportCsv" style="@style/ButtonText" android:text="@string/save_csv" />
            <Button android:id="@+id/btnImportCsv" style="@style/ButtonText" android:text="@string/import_csv" />
            <Button android:id="@+id/btnBackup" style="@style/ButtonText" android:text="@string/encrypted_backup" />
            <Button android:id="@+id/btnRestoreBackup" style="@style/ButtonText" android:text="@string/restore_backup" />
            <Button android:id="@+id/btnExportDiagnostics" style="@style/ButtonText" android:text="@string/export_diagnostics" />
            <Button android:id="@+id/btnDiagnostics" style="@style/ButtonText" android:text="@string/connection_diagnostics" />
            <TextView android:id="@+id/tvDiagnostics" style="@style/Body" android:visibility="gone" android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:id="@+id/tvChartTitle"
                android:text="@string/chart_last_hour" />

            <ru.tgwatch.ChartView
                android:id="@+id/chart"
                android:contentDescription="@string/chart_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/chart_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/battery_title" />
            <Button android:id="@+id/btnOnboarding" style="@style/ButtonText" android:text="@string/onboarding_open" />
            <Button android:id="@+id/btnAutomation" style="@style/ButtonText" android:text="@string/automation_settings" />
            <Button android:id="@+id/btnProfile" style="@style/ButtonText" android:text="@string/profile_default" />
            <Button
                android:id="@+id/btnAdvanced"
                style="@style/ButtonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/advanced_show" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/target_telegram_intervals" />
            <RadioGroup
                android:id="@+id/rgInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_segment_group"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/rb10"
                    style="@style/Segment"
                    android:text="@string/interval_10s" />

                <RadioButton
                    android:id="@+id/rb15"
                    style="@style/Segment"
                    android:text="@string/interval_15s" />

                <RadioButton
                    android:id="@+id/rb30"
                    style="@style/Segment"
                    android:text="@string/interval_30s" />

                <RadioButton
                    android:id="@+id/rb60"
                    style="@style/Segment"
                    android:text="@string/interval_1min" />

                <RadioButton
                    android:id="@+id/rb120"
                    style="@style/Segment"
                    android:text="@string/interval_2min" />
            </RadioGroup>

            <TextView
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/interval_hint"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/swKeepAwake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/keep_awake"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="2dp"
                android:text="@string/keep_awake_hint"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/swVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/vibrate_down"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swVibratePartial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/vibrate_partial"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/Body"
                android:text="@string/vibrate_partial_hint"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/swVibrateOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/vibrate_offline"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swVibrateRecovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/vibrate_recovery"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Switch android:id="@+id/swNotifyOutage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/notify_outage" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Switch android:id="@+id/swNotifyPartial" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/notify_partial" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Switch android:id="@+id/swNotifySlow" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/notify_slow" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Switch
                android:id="@+id/swNotifyRecovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/notify_recovery"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swEventSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/sound_outage"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Switch android:id="@+id/swSoundPartial" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/sound_partial" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Switch android:id="@+id/swSoundRecovery" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/sound_recovery" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btnChannelOutage" style="@style/ButtonText" android:text="@string/channel_outage" />
            <Button android:id="@+id/btnChannelPartial" style="@style/ButtonText" android:text="@string/channel_partial" />
            <Button android:id="@+id/btnChannelRecovery" style="@style/ButtonText" android:text="@string/channel_recovery" />
            <TextView
                style="@style/Body"
                android:text="@string/sound_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAlarmPattern"
                style="@style/ButtonText"
                android:text="@string/alarm_pattern_default" />

            <Switch
                android:id="@+id/swDailySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/daily_summary_default"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnDailySummaryTime"
                    style="@style/ButtonText"
                    android:text="@string/change_time" />
                <Button
                    android:id="@+id/btnDailySummaryNow"
                    style="@style/ButtonText"
                    android:text="@string/show_now" />
            </LinearLayout>

            <TextView
                style="@style/Body"
                android:text="@string/daily_summary_hint"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/swQuietHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/quiet_hours_default"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnQuietHours"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:text="@string/change_quiet_hours" />

            <Button
                android:id="@+id/btnVibe"
                style="@style/ButtonText"
                android:layout_marginTop="8dp"
                android:layout_marginStart="-12dp"
                android:text="@string/test_vibration" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/extra_probes_title" />
            <TextView
                style="@style/Body"
                android:layout_marginTop="2dp"
                android:text="@string/extra_probes_hint"
                android:textSize="12sp" />
            <Switch android:id="@+id/swExtraMatrix" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp"
                android:text="@string/extra_probe_matrix" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Switch android:id="@+id/swExtraWhatsapp" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/extra_probe_whatsapp" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Switch android:id="@+id/swExtraCustom" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/extra_probe_custom" android:textColor="@color/text_primary" android:textSize="15sp" />
            <Button
                android:id="@+id/btnExtraCustomUrl"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:text="@string/extra_probe_custom_url_unset" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/background_title" />

            <TextView
                android:id="@+id/tvNotif"
                style="@style/Body"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnNotif"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:text="@string/enable_notifications" />

            <TextView
                android:id="@+id/tvBattery"
                style="@style/Body"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnBattery"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:text="@string/allow_unrestricted" />

            <TextView
                android:id="@+id/tvAlarm"
                style="@style/Body"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnAlarm"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:text="@string/allow_exact_alarms" />

            <TextView
                android:id="@+id/tvOem"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAppDetails"
                style="@style/ButtonText"
                android:layout_marginStart="-12dp"
                android:text="@string/open_app_settings" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/log_title" />

            <TextView
                android:id="@+id/tvLog"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnShareLog"
                    style="@style/ButtonText"
                    android:layout_marginStart="-12dp"
                    android:text="@string/share" />

                <Button
                    android:id="@+id/btnClearLog"
                    style="@style/ButtonText"
                    android:text="@string/clear" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

