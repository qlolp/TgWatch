<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card">
    <TextView android:id="@+id/incidentCenterText" style="@style/Body"
        android:textColor="@color/text_primary" android:textIsSelectable="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/incidentCenterDetails" style="@style/ButtonText"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/incident_center_target_details" />
        <Button android:id="@+id/incidentCenterCheck" style="@style/ButtonText"
            android:layout_width="0dp" android:layout_weight="1" android:text="@string/check_now" />
    </LinearLayout>
</LinearLayout>
