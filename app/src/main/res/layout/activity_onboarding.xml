<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="@color/bg">
    <TextView android:id="@+id/tvOnboardingStep" style="@style/Body" />
    <TextView android:id="@+id/tvOnboardingTitle" style="@style/CardTitle" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvOnboardingBody" style="@style/Body" />
            <Button android:id="@+id/btnOnboardingAction" style="@style/ButtonOutlined" />
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnOnboardingNext" style="@style/ButtonFilled" />
    <Button android:id="@+id/btnOnboardingSkip" style="@style/ButtonText" android:text="@string/onboarding_skip" />
</LinearLayout>
