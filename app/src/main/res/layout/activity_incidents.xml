<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/incidentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="@color/bg">
    <TextView style="@style/CardTitle" android:text="@string/incidents_title" />
    <TextView style="@style/Body" android:text="@string/incidents_hint" />
    <Button android:id="@+id/incidentPeriod" style="@style/ButtonText" android:text="@string/period_week" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/incidentList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="@android:color/transparent"
            android:dividerHeight="12dp" />
        <TextView android:id="@+id/incidentEmpty" style="@style/Body"
            android:text="@string/history_loading" android:accessibilityLiveRegion="polite" />
    </FrameLayout>
    <Button android:id="@+id/incidentDone" style="@style/ButtonText" android:text="@string/automation_done" />
</LinearLayout>
