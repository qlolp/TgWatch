root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
max_line_length = 140

[*.{xml,yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,gradle}]
indent_size = 2
